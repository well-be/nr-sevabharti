---
import { ArrowRight } from 'lucide-astro';

interface Props {
  title: string;
  description: string;
  category: 'education' | 'environment';
  features: { title: string; desc: string }[];
  linkUrl: string;
  linkText: string;
}

const { title, description, category, features, linkUrl, linkText } = Astro.props;

const isEdu = category === 'education';
const badgeColor = isEdu 
  ? 'bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300' 
  : 'bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300';

const accentBtn = isEdu 
  ? 'bg-edu-500 hover:bg-edu-600 text-white' 
  : 'bg-brand-500 hover:bg-brand-600 text-white';
---

<div class="glass-card bg-white/90 dark:bg-slate-900/90 rounded-3xl overflow-hidden flex flex-col justify-between transition-colors duration-200">
  
  <div class="p-8">
    <div class="flex items-center justify-between mb-4">
      <span class={`text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full ${badgeColor}`}>
        {isEdu ? 'Education Initiative' : 'Environment Care'}
      </span>
    </div>

    <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">
      {title}
    </h3>
    <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-6">
      {description}
    </p>

    <div class="space-y-4 pt-4 border-t border-slate-100 dark:border-slate-800">
      {features.map((feat) => (
        <div class="flex items-start gap-3">
          <div class={`w-2 h-2 rounded-full mt-2 shrink-0 ${isEdu ? 'bg-amber-500' : 'bg-emerald-500'}`}></div>
          <div>
            <h4 class="text-sm font-semibold text-slate-800 dark:text-slate-200">{feat.title}</h4>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-snug">{feat.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="p-6 bg-slate-50/60 dark:bg-slate-800/40 border-t border-slate-100 dark:border-slate-800 flex items-center justify-end">
    <a
      href={linkUrl}
      class={`inline-flex items-center gap-2 text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-all ${accentBtn}`}
    >
      <span>{linkText}</span>
      <ArrowRight class="w-4 h-4" />
    </a>
  </div>

</div>
