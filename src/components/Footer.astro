---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import { MapPin, Phone, Mail, Award, Heart, GraduationCap, Leaf } from 'lucide-astro';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
---

<footer class="bg-slate-100 dark:bg-slate-950 text-slate-700 dark:text-slate-300 pt-16 pb-8 border-t border-slate-200 dark:border-slate-800/80 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      
      <!-- Column 1: Organization Brief -->
      <div class="space-y-4">
        <div class="flex items-center gap-2.5 text-slate-900 dark:text-white font-extrabold text-xl">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-palette-indigo to-palette-sky flex items-center justify-center text-white text-sm shrink-0">
            <div class="relative">
              <GraduationCap class="w-3.5 h-3.5 absolute -top-0.5 -left-0.5 opacity-90" />
              <Leaf class="w-3.5 h-3.5 absolute -bottom-0.5 -right-0.5 text-palette-gold" />
            </div>
          </div>
          <span>{t('ngo.name')}</span>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          {t('ngo.tagline')}
        </p>
        <div class="inline-flex items-center gap-2 bg-palette-gold/15 dark:bg-palette-gold/10 border border-palette-gold/30 rounded-lg px-3 py-1.5 text-xs text-palette-gold-dark dark:text-palette-gold font-semibold">
          <Award class="w-4 h-4" />
          <span>{t('donate.badge80G')}</span>
        </div>
      </div>

      <!-- Column 2: Programs -->
      <div>
        <h3 class="text-slate-900 dark:text-white font-semibold text-base mb-4 border-b border-slate-200 dark:border-slate-800 pb-2">
          {t('action.explorePrograms')}
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href={translatePath('/education')} class="hover:text-palette-indigo dark:hover:text-palette-aqua transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-palette-gold"></span>
              {t('program.education.title')}
            </a>
          </li>
          <li>
            <a href={translatePath('/environment')} class="hover:text-palette-indigo dark:hover:text-palette-aqua transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-palette-sky"></span>
              {t('program.environment.title')}
            </a>
          </li>
          <li>
            <a href={translatePath('/volunteer')} class="hover:text-palette-indigo dark:hover:text-palette-aqua transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-palette-aqua"></span>
              {t('vol.title')}
            </a>
          </li>
          <li>
            <a href={translatePath('/donate')} class="hover:text-palette-indigo dark:hover:text-palette-aqua transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-palette-gold"></span>
              {t('donate.title')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Focus Areas (Purified with Zero Mixed Text) -->
      <div>
        <h3 class="text-slate-900 dark:text-white font-semibold text-base mb-4 border-b border-slate-200 dark:border-slate-800 pb-2">
          {t('footer.focusTitle')}
        </h3>
        <ul class="text-sm text-slate-600 dark:text-slate-400 space-y-2">
          <li class="flex items-start gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-palette-indigo shrink-0 mt-1.5"></span>
            <span>{t('footer.area1')}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-palette-sky shrink-0 mt-1.5"></span>
            <span>{t('footer.area2')}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-palette-aqua shrink-0 mt-1.5"></span>
            <span>{t('footer.area3')}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-palette-gold shrink-0 mt-1.5"></span>
            <span>{t('footer.area4')}</span>
          </li>
        </ul>
      </div>

      <!-- Column 4: Contact & Office -->
      <div>
        <h3 class="text-slate-900 dark:text-white font-semibold text-base mb-4 border-b border-slate-200 dark:border-slate-800 pb-2">
          {t('action.contactUs')}
        </h3>
        <ul class="space-y-3 text-sm text-slate-600 dark:text-slate-400">
          <li class="flex items-start gap-3">
            <MapPin class="w-5 h-5 text-palette-sky dark:text-palette-aqua shrink-0 mt-0.5" />
            <span>{t('footer.addr')}</span>
          </li>
          <li class="flex items-center gap-3">
            <Phone class="w-4 h-4 text-palette-sky dark:text-palette-aqua shrink-0" />
            <a href="https://wa.me/918285129797" target="_blank" class="hover:text-palette-indigo dark:hover:text-palette-aqua transition-colors">
              {t('footer.phone')}
            </a>
          </li>
          <li class="flex items-center gap-3">
            <Mail class="w-4 h-4 text-palette-sky dark:text-palette-aqua shrink-0" />
            <a href={`mailto:${t('footer.email')}`} class="hover:text-palette-indigo dark:hover:text-palette-aqua transition-colors">
              {t('footer.email')}
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright & Mission Line -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 dark:text-slate-500 gap-4">
      <p>{t('footer.rights')}</p>
      <p class="flex items-center gap-1.5">
        <span>{t('footer.madeWith')}</span>
        <Heart class="w-3.5 h-3.5 text-palette-gold fill-palette-gold" />
        <span>{t('footer.missionText')}</span>
      </p>
    </div>

  </div>
</footer>
