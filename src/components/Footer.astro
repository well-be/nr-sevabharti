---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import { MapPin, Phone, Mail, Award, Heart, GraduationCap, Leaf } from 'lucide-astro';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
---

<footer class="bg-slate-100 dark:bg-slate-950 text-slate-700 dark:text-slate-300 pt-16 pb-8 border-t border-slate-200 dark:border-slate-800/80 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      
      <!-- Column 1: Organization Brief -->
      <div class="space-y-4">
        <div class="flex items-center gap-2.5 text-slate-900 dark:text-white font-extrabold text-xl">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-eco-600 flex items-center justify-center text-white text-sm shrink-0">
            <div class="relative">
              <GraduationCap class="w-3.5 h-3.5 absolute -top-0.5 -left-0.5 opacity-90" />
              <Leaf class="w-3.5 h-3.5 absolute -bottom-0.5 -right-0.5 text-amber-300" />
            </div>
          </div>
          <span>{t('ngo.name')}</span>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          {t('ngo.tagline')}
        </p>
        <div class="inline-flex items-center gap-2 bg-slate-200/80 dark:bg-slate-800 border border-slate-300/80 dark:border-slate-700 rounded-lg px-3 py-1.5 text-xs text-amber-700 dark:text-amber-400 font-medium">
          <Award class="w-4 h-4" />
          <span>{t('donate.badge80G')}</span>
        </div>
      </div>

      <!-- Column 2: Programs -->
      <div>
        <h3 class="text-slate-900 dark:text-white font-semibold text-base mb-4 border-b border-slate-200 dark:border-slate-800 pb-2">
          {t('action.explorePrograms')}
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href={translatePath('/education')} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              {t('program.education.title')}
            </a>
          </li>
          <li>
            <a href={translatePath('/environment')} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              {t('program.environment.title')}
            </a>
          </li>
          <li>
            <a href={translatePath('/volunteer')} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              {t('vol.title')}
            </a>
          </li>
          <li>
            <a href={translatePath('/donate')} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              {t('donate.title')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Focus Areas -->
      <div>
        <h3 class="text-slate-900 dark:text-white font-semibold text-base mb-4 border-b border-slate-200 dark:border-slate-800 pb-2">
          प्रमुख कार्यक्षेत्रे (Major Focus Areas)
        </h3>
        <ul class="text-sm text-slate-600 dark:text-slate-400 space-y-1.5">
          <li>• पुणे शहर व ग्रामीण भाग (Pune & Rural)</li>
          <li>• सह्याद्री डोंगररांगा & देवराई (Sahyadri Region)</li>
          <li>• हवेली, मुळशी, शिरूर, खेड & मावळ</li>
          <li>• पिंपरी-चिंचवड व आसपासचा परिसर</li>
        </ul>
      </div>

      <!-- Column 4: Contact & Office -->
      <div>
        <h3 class="text-slate-900 dark:text-white font-semibold text-base mb-4 border-b border-slate-200 dark:border-slate-800 pb-2">
          {t('action.contactUs')}
        </h3>
        <ul class="space-y-3 text-sm text-slate-600 dark:text-slate-400">
          <li class="flex items-start gap-3">
            <MapPin class="w-5 h-5 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" />
            <span>{t('footer.addr')}</span>
          </li>
          <li class="flex items-center gap-3">
            <Phone class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" />
            <a href="https://wa.me/919021116405" target="_blank" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              {t('footer.phone')}
            </a>
          </li>
          <li class="flex items-center gap-3">
            <Mail class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" />
            <a href="mailto:contact@nr-sevabharti.org" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              {t('footer.email')}
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 dark:text-slate-500 gap-4">
      <p>{t('footer.rights')}</p>
      <p class="flex items-center gap-1">
        <span>Made with</span>
        <Heart class="w-3.5 h-3.5 text-rose-500 fill-rose-500" />
        <span>for Education & Environment Care</span>
      </p>
    </div>

  </div>
</footer>
