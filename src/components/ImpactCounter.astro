---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { GraduationCap, Trees, MapPin, Users } from 'lucide-astro';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const stats = [
  {
    icon: GraduationCap,
    number: t('stat.students'),
    label: t('stat.studentsLabel'),
    color: 'from-palette-gold to-palette-gold-dark',
    bgColor: 'bg-palette-gold/20 text-palette-gold-dark dark:text-palette-gold'
  },
  {
    icon: Trees,
    number: t('stat.trees'),
    label: t('stat.treesLabel'),
    color: 'from-palette-sky to-palette-aqua-dark',
    bgColor: 'bg-palette-aqua/25 text-palette-sky-dark dark:text-palette-aqua'
  },
  {
    icon: MapPin,
    number: t('stat.talukas'),
    label: t('stat.talukasLabel'),
    color: 'from-palette-indigo to-palette-sky',
    bgColor: 'bg-palette-indigo/20 text-palette-indigo dark:text-palette-sky-light'
  },
  {
    icon: Users,
    number: t('stat.volunteers'),
    label: t('stat.volunteersLabel'),
    color: 'from-palette-gold to-palette-indigo',
    bgColor: 'bg-palette-aqua/20 text-palette-indigo dark:text-palette-gold'
  }
];
---

<section class="py-16 bg-gradient-to-b from-slate-100 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-brand-950/40 dark:to-slate-950 text-slate-900 dark:text-white relative overflow-hidden transition-colors duration-300">
  <!-- Subtle background blur circles -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-palette-aqua/15 dark:bg-palette-aqua/20 rounded-full blur-3xl"></div>
  <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-palette-gold/15 dark:bg-palette-gold/20 rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight bg-gradient-to-r from-palette-gold via-palette-indigo to-palette-sky dark:from-palette-gold dark:via-white dark:to-palette-aqua bg-clip-text text-transparent">
        {t('impact.title')}
      </h2>
      <p class="mt-4 text-base text-slate-600 dark:text-slate-300 font-medium">
        {t('impact.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {stats.map((stat) => {
        const IconComponent = stat.icon;
        return (
          <div class="glass-card rounded-2xl p-6 text-center hover:scale-105 transition-transform duration-300 shadow-sm">
            <div class={`w-14 h-14 mx-auto rounded-2xl flex items-center justify-center shadow-xs mb-4 ${stat.bgColor}`}>
              <IconComponent class="w-7 h-7" />
            </div>
            <div class={`text-4xl font-black bg-gradient-to-r ${stat.color} bg-clip-text text-transparent mb-1`}>
              {stat.number}
            </div>
            <p class="text-sm font-semibold text-slate-700 dark:text-slate-300">
              {stat.label}
            </p>
          </div>
        );
      })}
    </div>
  </div>
</section>
