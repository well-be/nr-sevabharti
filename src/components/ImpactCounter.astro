---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { GraduationCap, Trees, MapPin, Users } from 'lucide-astro';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const stats = [
  {
    icon: GraduationCap,
    number: t('stat.students'),
    label: t('stat.studentsLabel'),
    color: 'from-amber-500 to-amber-600',
    bgColor: 'bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-300'
  },
  {
    icon: Trees,
    number: t('stat.trees'),
    label: t('stat.treesLabel'),
    color: 'from-emerald-500 to-emerald-700',
    bgColor: 'bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300'
  },
  {
    icon: MapPin,
    number: t('stat.talukas'),
    label: t('stat.talukasLabel'),
    color: 'from-blue-500 to-indigo-700',
    bgColor: 'bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300'
  },
  {
    icon: Users,
    number: t('stat.volunteers'),
    label: t('stat.volunteersLabel'),
    color: 'from-rose-500 to-pune-accent',
    bgColor: 'bg-rose-100 dark:bg-rose-950 text-rose-700 dark:text-rose-300'
  }
];
---

<section class="py-16 bg-gradient-to-b from-slate-100 via-slate-50 to-slate-100 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 text-slate-900 dark:text-white relative overflow-hidden transition-colors duration-300">
  <!-- Subtle background blur circles -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-emerald-500/10 dark:bg-emerald-600/20 rounded-full blur-3xl"></div>
  <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-amber-500/10 dark:bg-amber-600/20 rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight bg-gradient-to-r from-amber-700 via-brand-800 to-emerald-700 dark:from-amber-200 dark:via-white dark:to-emerald-200 bg-clip-text text-transparent">
        {t('impact.title')}
      </h2>
      <p class="mt-4 text-base text-slate-600 dark:text-slate-300 font-medium">
        {t('impact.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {stats.map((stat) => {
        const IconComponent = stat.icon;
        return (
          <div class="glass-card rounded-2xl p-6 text-center hover:scale-105 transition-transform duration-300 shadow-sm">
            <div class={`w-14 h-14 mx-auto rounded-2xl flex items-center justify-center shadow-xs mb-4 ${stat.bgColor}`}>
              <IconComponent class="w-7 h-7" />
            </div>
            <div class={`text-4xl font-black bg-gradient-to-r ${stat.color} bg-clip-text text-transparent mb-1`}>
              {stat.number}
            </div>
            <p class="text-sm font-semibold text-slate-700 dark:text-slate-300">
              {stat.label}
            </p>
          </div>
        );
      })}
    </div>
  </div>
</section>
