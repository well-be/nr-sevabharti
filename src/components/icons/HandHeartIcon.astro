  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
>
  <!-- Hand Base -->
  <path
    d="M2 13.5C2 13.5 4 11 6.5 11C9 11 11 13 14 13C16 13 19 12 21 13C22 13.5 22 15 20.5 16C19 17 16 18.5 12 18.5C8 18.5 5 17 2 13.5Z"
    class="fill-palette-aqua/35 stroke-palette-indigo"
    stroke-width="1.8"
    stroke-linejoin="round"
  />
  <path
    d="M4 17L7 22H14"
    class="stroke-palette-indigo"
    stroke-width="1.8"
    stroke-linecap="round"
  />
  <!-- Radiant Seva Heart in Honey Gold -->
  <path
    d="M14 3.5C12.8 3.5 12 4.5 12 4.5C12 4.5 11.2 3.5 10 3.5C8.6 3.5 7.5 4.6 7.5 6C7.5 7.8 9.5 9.5 12 11C14.5 9.5 16.5 7.8 16.5 6C16.5 4.6 15.4 3.5 14 3.5Z"
