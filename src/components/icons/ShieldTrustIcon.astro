    d="M12 4L5.5 6.9V11.5C5.5 15.6 8.3 19.2 12 20.3C15.7 19.2 18.5 15.6 18.5 11.5V6.9L12 4Z"
    class="fill-palette-aqua/25"
  />
  <path
    d="M8.5 11.5L11 14L16 9"
