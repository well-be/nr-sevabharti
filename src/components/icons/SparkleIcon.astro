---
interface Props {
  class?: string;
  size?: number;
}

const { class: className = "w-5 h-5", size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
>
  <path
    d="M12 2L14.4 8.6L21 11L14.4 13.4L12 20L9.6 13.4L3 11L9.6 8.6L12 2Z"
    class="fill-palette-gold"
  />
  <circle cx="19" cy="5" r="2" class="fill-palette-aqua" />
  <circle cx="5" cy="19" r="1.5" class="fill-palette-sky" />
</svg>
