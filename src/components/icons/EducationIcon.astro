---
interface Props {
  class?: string;
  size?: number;
}

const { class: className = "w-5 h-5", size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
>
  <!-- Book Base in Soft Aqua / Indigo Outline -->
  <path
    d="M4 19.5V6.5C4 5.4 4.9 4.5 6 4.5H11C11.6 4.5 12 4.9 12 5.5V20C11.5 19.4 10.8 19 10 19H5.5C4.7 19 4 19.2 4 19.5Z"
    class="fill-palette-aqua/35 stroke-palette-indigo"
    stroke-width="1.8"
    stroke-linejoin="round"
  />
  <path
    d="M20 19.5V6.5C20 5.4 19.1 4.5 18 4.5H13C12.4 4.5 12 4.9 12 5.5V20C12.5 19.4 13.2 19 14 19H18.5C19.3 19 20 19.2 20 19.5Z"
    class="fill-palette-aqua/35 stroke-palette-indigo"
    stroke-width="1.8"
    stroke-linejoin="round"
  />
  <!-- Graduation Cap in Honey Gold -->
  <path
    d="M12 2L6 5.5L12 9L18 5.5L12 2Z"
    class="fill-palette-gold"
  />
  <circle cx="18" cy="8" r="1.5" class="fill-palette-sky" />
</svg>
