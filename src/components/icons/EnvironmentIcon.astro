---
interface Props {
  class?: string;
  size?: number;
}

const { class: className = "w-5 h-5", size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
>
  <!-- Main Leaf in Royal Indigo and Soft Aqua -->
  <path
    d="M19.5 4.5C19.5 4.5 13.5 4 8.5 9C4.5 13 4.5 18 4.5 18C4.5 18 9.5 18 13.5 14C18.5 9 19.5 4.5 19.5 4.5Z"
    class="fill-palette-aqua/35 stroke-palette-indigo"
    stroke-width="1.8"
    stroke-linejoin="round"
  />
  <path
    d="M4.5 18L11 11.5"
    class="stroke-palette-indigo"
    stroke-width="1.8"
    stroke-linecap="round"
  />
  <!-- Fresh Sun / Sprout Bud in Honey Gold -->
  <circle cx="16" cy="7" r="2.5" class="fill-palette-gold" />
  <!-- Water Dewdrop in Sky Cerulean -->
  <path
    d="M17 14C17 15.6569 15.6569 17 14 17C12.3431 17 11 15.6569 11 14C11 12.5 14 10 14 10C14 10 17 12.5 17 14Z"
    class="fill-palette-sky"
  />
</svg>
