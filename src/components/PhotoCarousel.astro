---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { ChevronLeft, ChevronRight, MapPin, Sparkles, ShieldCheck } from 'lucide-astro';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const slides = [
  {
    src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets/taljai-drive-1.png`,
    title: t('carousel.slide1.title'),
    desc: t('carousel.slide1.desc'),
    tag: 'Taljai Tekadi • Pune',
    badgeColor: 'bg-palette-gold text-slate-950'
  },
  {
    src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets/taljai-drive-2.png`,
    title: t('carousel.slide2.title'),
    desc: t('carousel.slide2.desc'),
    tag: 'Tree Plantation Drive',
    badgeColor: 'bg-palette-sky text-white'
  },
  {
    src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets/taljai-drive-3.png`,
    title: t('carousel.slide3.title'),
    desc: t('carousel.slide3.desc'),
    tag: 'Volunteers on Ground',
    badgeColor: 'bg-palette-indigo text-white'
  },
  {
    src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets/taljai-drive-4.png`,
    title: t('carousel.slide4.title'),
    desc: t('carousel.slide4.desc'),
    tag: 'Community Participation',
    badgeColor: 'bg-palette-aqua text-slate-950'
  },
  {
    src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets/taljai-drive-5.png`,
    title: t('carousel.slide5.title'),
    desc: t('carousel.slide5.desc'),
    tag: 'Green Pledge Ceremony',
    badgeColor: 'bg-palette-gold text-slate-950'
  },
];
---

<section class="py-16 sm:py-20 relative overflow-hidden bg-slate-50 dark:bg-slate-950 transition-colors duration-300">
  
  <!-- Subtle Ambient Glow Orbs -->
  <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-96 h-96 bg-palette-indigo/15 dark:bg-palette-indigo/25 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-96 h-96 bg-palette-gold/15 dark:bg-palette-gold/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
      <div class="inline-flex items-center gap-2 bg-palette-gold/20 border border-palette-gold/40 text-palette-gold-dark dark:text-palette-gold text-xs font-bold px-4 py-1.5 rounded-full shadow-xs mb-3">
        <Sparkles class="w-3.5 h-3.5" />
        <span>{t('carousel.badge')}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {t('carousel.title')}
      </h2>
      <p class="mt-3 text-slate-600 dark:text-slate-300 text-sm sm:text-base max-w-2xl mx-auto font-medium">
        {t('carousel.subtitle')}
      </p>
    </div>

    <!-- Main Carousel Stage -->
    <div id="photo-carousel" class="relative group max-w-5xl mx-auto">
      
      <!-- Luminous Border Glow -->
      <div class="absolute -inset-1 sm:-inset-1.5 bg-gradient-to-r from-palette-gold/40 via-palette-indigo/40 to-palette-sky/40 rounded-3xl sm:rounded-4xl blur-xl opacity-60 group-hover:opacity-90 transition-opacity duration-500 -z-10"></div>

      <!-- Viewport Frame -->
      <div class="relative aspect-[16/10] sm:aspect-[16/9] lg:aspect-[21/10] w-full rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl border border-white/40 dark:border-slate-800 bg-slate-900">
        
        <!-- Slides Container -->
        <div id="carousel-track" class="w-full h-full relative">
          {slides.map((slide, index) => (
            <div
              class={`carousel-slide absolute inset-0 w-full h-full transition-all duration-700 ease-out ${
                index === 0 ? 'opacity-100 scale-100 z-10' : 'opacity-0 scale-95 pointer-events-none z-0'
              }`}
              data-index={index}
            >
              <!-- Photo with vibrancy enhancer and watermark clipping -->
              <img
                src={slide.src}
                alt={slide.title}
                loading={index === 0 ? 'eager' : 'lazy'}
                class="w-full h-full object-cover object-center filter contrast-[1.04] brightness-[1.02] saturate-[1.06] transition-transform duration-700"
              />

              <!-- Cinematic Dark Gradient Vignette for Text Readability -->
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/30 to-slate-950/15"></div>

              <!-- Top Left Tag & Location Pill -->
              <div class="absolute top-4 left-4 sm:top-6 sm:left-6 flex flex-wrap items-center gap-2 z-20">
                <span class={`text-[11px] sm:text-xs font-bold px-3 py-1 rounded-full shadow-md ${slide.badgeColor}`}>
                  {slide.tag}
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-950/70 backdrop-blur-md text-white text-[11px] sm:text-xs font-semibold border border-white/20 shadow-md">
                  <MapPin class="w-3.5 h-3.5 text-palette-gold" />
                  <span>{t('carousel.venue')}</span>
                </span>
              </div>

              <!-- Top Right Official Proof Badge -->
              <div class="hidden sm:flex absolute top-6 right-6 items-center gap-1.5 px-3.5 py-1 rounded-full bg-slate-950/70 backdrop-blur-md text-slate-200 text-xs font-medium border border-white/20 z-20 shadow-md">
                <ShieldCheck class="w-4 h-4 text-palette-aqua" />
                <span class="font-mono text-[11px]">{t('carousel.official')}</span>
              </div>

              <!-- Bottom Content Overlay -->
              <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-8 z-20">
                <div class="max-w-3xl">
                  <h3 class="text-lg sm:text-2xl font-black text-white leading-tight drop-shadow-md">
                    {slide.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-slate-200 mt-1.5 leading-relaxed font-medium drop-shadow-sm max-w-2xl">
                    {slide.desc}
                  </p>
                </div>
              </div>

            </div>
          ))}
        </div>

        <!-- Left Navigation Arrow -->
        <button
          type="button"
          id="carousel-btn-prev"
          aria-label="Previous Photo"
          class="absolute left-3 sm:left-5 top-1/2 -translate-y-1/2 z-30 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-slate-950/50 hover:bg-palette-gold text-white hover:text-slate-950 backdrop-blur-md border border-white/30 flex items-center justify-center shadow-lg transition-all duration-200 hover:scale-110 active:scale-95 cursor-pointer"
        >
          <ChevronLeft class="w-5 h-5 sm:w-6 sm:h-6" />
        </button>

        <!-- Right Navigation Arrow -->
        <button
          type="button"
          id="carousel-btn-next"
          aria-label="Next Photo"
          class="absolute right-3 sm:right-5 top-1/2 -translate-y-1/2 z-30 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-slate-950/50 hover:bg-palette-gold text-white hover:text-slate-950 backdrop-blur-md border border-white/30 flex items-center justify-center shadow-lg transition-all duration-200 hover:scale-110 active:scale-95 cursor-pointer"
        >
          <ChevronRight class="w-5 h-5 sm:w-6 sm:h-6" />
        </button>

        <!-- Slide Counter Pill -->
        <div class="absolute bottom-4 right-4 sm:bottom-6 sm:right-6 z-30 px-3 py-1 rounded-full bg-slate-950/70 backdrop-blur-md border border-white/20 text-white font-mono text-xs font-bold shadow-md">
          <span id="carousel-current">1</span> / <span>{slides.length}</span>
        </div>

      </div>

      <!-- Interactive Dot Indicators & Thumbnails -->
      <div class="flex items-center justify-center gap-2 mt-4 sm:mt-6">
        {slides.map((_, i) => (
          <button
            type="button"
            class="carousel-indicator h-2.5 rounded-full transition-all duration-300 cursor-pointer"
            aria-label={`Go to slide ${i + 1}`}
            data-target={i}
            class:list={[i === 0 ? 'w-8 bg-palette-gold shadow-md' : 'w-2.5 bg-slate-300 dark:bg-slate-700 hover:bg-slate-400']}
          />
        ))}
      </div>

      <!-- Thumbnail Preview Strip for Instant Visual Selection -->
      <div class="hidden sm:grid grid-cols-5 gap-3 mt-4">
        {slides.map((slide, i) => (
          <button
            type="button"
            class={`carousel-thumb relative aspect-[16/10] rounded-xl overflow-hidden border-2 transition-all duration-200 cursor-pointer ${
              i === 0 ? 'border-palette-gold ring-2 ring-palette-gold/30 shadow-md scale-[1.02]' : 'border-transparent opacity-60 hover:opacity-100'
            }`}
            data-target={i}
          >
            <img src={slide.src} alt="" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-slate-950/20"></div>
          </button>
        ))}
      </div>

    </div>

  </div>
</section>

<script>
  function setupPhotoCarousel() {
    const root = document.getElementById('photo-carousel');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const slides = root.querySelectorAll('.carousel-slide');
    const indicators = root.querySelectorAll('.carousel-indicator');
    const thumbs = root.querySelectorAll('.carousel-thumb');
    const prevBtn = document.getElementById('carousel-btn-prev');
    const nextBtn = document.getElementById('carousel-btn-next');
    const counter = document.getElementById('carousel-current');

    if (!slides.length) return;

    let currentIndex = 0;
    let autoInterval: any = null;

    function showSlide(index: number) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      currentIndex = index;

      slides.forEach((slide, i) => {
        if (i === currentIndex) {
          slide.classList.remove('opacity-0', 'scale-95', 'pointer-events-none', 'z-0');
          slide.classList.add('opacity-100', 'scale-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'scale-100', 'z-10');
          slide.classList.add('opacity-0', 'scale-95', 'pointer-events-none', 'z-0');
        }
      });

      indicators.forEach((ind, i) => {
        if (i === currentIndex) {
          ind.classList.remove('w-2.5', 'bg-slate-300', 'dark:bg-slate-700');
          ind.classList.add('w-8', 'bg-palette-gold', 'shadow-md');
        } else {
          ind.classList.remove('w-8', 'bg-palette-gold', 'shadow-md');
          ind.classList.add('w-2.5', 'bg-slate-300', 'dark:bg-slate-700');
        }
      });

      thumbs.forEach((th, i) => {
        if (i === currentIndex) {
          th.classList.remove('border-transparent', 'opacity-60');
          th.classList.add('border-palette-gold', 'ring-2', 'ring-palette-gold/30', 'shadow-md', 'scale-[1.02]');
        } else {
          th.classList.remove('border-palette-gold', 'ring-2', 'ring-palette-gold/30', 'shadow-md', 'scale-[1.02]');
          th.classList.add('border-transparent', 'opacity-60');
        }
      });

      if (counter) counter.textContent = String(currentIndex + 1);
    }

    function nextSlide() {
      showSlide(currentIndex + 1);
    }

    function prevSlide() {
      showSlide(currentIndex - 1);
    }

    function startAuto() {
      stopAuto();
      autoInterval = setInterval(nextSlide, 5000);
    }

    function stopAuto() {
      if (autoInterval) {
        clearInterval(autoInterval);
        autoInterval = null;
      }
    }

    prevBtn?.addEventListener('click', () => {
      prevSlide();
      startAuto();
    });

    nextBtn?.addEventListener('click', () => {
      nextSlide();
      startAuto();
    });

    indicators.forEach((ind) => {
      ind.addEventListener('click', () => {
        const target = Number(ind.getAttribute('data-target'));
        if (!isNaN(target)) {
          showSlide(target);
          startAuto();
        }
      });
    });

    thumbs.forEach((th) => {
      th.addEventListener('click', () => {
        const target = Number(th.getAttribute('data-target'));
        if (!isNaN(target)) {
          showSlide(target);
          startAuto();
        }
      });
    });

    root.addEventListener('mouseenter', stopAuto);
    root.addEventListener('mouseleave', startAuto);

    // Touch Swipe Support for Mobile
    let startX = 0;
    root.addEventListener('touchstart', (e) => {
      startX = e.changedTouches[0].screenX;
      stopAuto();
    }, { passive: true });

    root.addEventListener('touchend', (e) => {
      const endX = e.changedTouches[0].screenX;
      const diff = startX - endX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) nextSlide();
        else prevSlide();
      }
      startAuto();
    }, { passive: true });

    startAuto();
  }

  setupPhotoCarousel();
  document.addEventListener('astro:after-swap', setupPhotoCarousel);
</script>
