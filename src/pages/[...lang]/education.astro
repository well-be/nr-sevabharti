---
import Layout from '../../layouts/Layout.astro';
import { languages } from '../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import { BookOpen, Laptop, Award } from 'lucide-astro';
import { EducationIcon, HeartIcon } from '../../components/icons';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'en' } },
    { params: { lang: 'hi' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang as keyof typeof languages) || 'mr';
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
---

<Layout title={`${t('program.education.title')} | ${t('ngo.name')}`}>
  
  <!-- Page Banner -->
  <section class="bg-gradient-to-r from-palette-gold via-palette-gold to-amber-500 text-slate-950 py-16 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 bg-slate-950/15 text-slate-950 text-xs font-bold px-3.5 py-1.5 rounded-full mb-3 border border-slate-950/20">
          <EducationIcon class="w-4 h-4 shrink-0" />
          <span>{t('edu.pageBadge')}</span>
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold mb-3">
          {t('program.education.title')}
        </h1>
        <p class="text-slate-900 text-base leading-relaxed font-medium">
          {t('program.education.desc')}
        </p>
      </div>
    </div>
  </section>

  <!-- Detailed Projects List -->
  <section class="py-16 bg-white dark:bg-slate-950 transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        
        <div class="bg-palette-gold/10 dark:bg-slate-900 p-8 rounded-3xl border border-palette-gold/30 dark:border-slate-800 shadow-xs">
          <div class="w-12 h-12 rounded-2xl bg-palette-gold text-slate-950 flex items-center justify-center mb-6 shadow-md font-bold">
            <BookOpen class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">{t('edu.feat1.title')}</h3>
          <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-4">{t('edu.feat1.desc')}</p>
          <ul class="text-xs text-slate-600 dark:text-slate-400 space-y-2.5">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-palette-gold shrink-0"></span>
              <span>{t('edu.bullet1_1')}</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-palette-gold shrink-0"></span>
              <span>{t('edu.bullet1_2')}</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-palette-gold shrink-0"></span>
              <span>{t('edu.bullet1_3')}</span>
            </li>
          </ul>
        </div>

        <div class="bg-palette-gold/10 dark:bg-slate-900 p-8 rounded-3xl border border-palette-gold/30 dark:border-slate-800 shadow-xs">
          <div class="w-12 h-12 rounded-2xl bg-palette-gold text-slate-950 flex items-center justify-center mb-6 shadow-md font-bold">
            <Laptop class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">{t('edu.feat2.title')}</h3>
          <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-4">{t('edu.feat2.desc')}</p>
          <ul class="text-xs text-slate-600 dark:text-slate-400 space-y-2.5">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-palette-gold shrink-0"></span>
              <span>{t('edu.bullet2_1')}</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-palette-gold shrink-0"></span>
              <span>{t('edu.bullet2_2')}</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-palette-gold shrink-0"></span>
              <span>{t('edu.bullet2_3')}</span>
            </li>
          </ul>
        </div>

        <div class="bg-palette-gold/10 dark:bg-slate-900 p-8 rounded-3xl border border-palette-gold/30 dark:border-slate-800 shadow-xs">
          <div class="w-12 h-12 rounded-2xl bg-palette-gold text-slate-950 flex items-center justify-center mb-6 shadow-md font-bold">
            <Award class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">{t('edu.feat3.title')}</h3>
          <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-4">{t('edu.feat3.desc')}</p>
          <ul class="text-xs text-slate-600 dark:text-slate-400 space-y-2.5">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-palette-gold shrink-0"></span>
              <span>{t('edu.bullet3_1')}</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-palette-gold shrink-0"></span>
              <span>{t('edu.bullet3_2')}</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-palette-gold shrink-0"></span>
              <span>{t('edu.bullet3_3')}</span>
            </li>
          </ul>
        </div>

      </div>

      <!-- Support CTA Banner -->
      <div class="bg-gradient-to-r from-palette-gold to-amber-500 text-slate-950 rounded-3xl p-8 sm:p-12 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-lg shadow-palette-gold/20">
        <div class="space-y-2 text-center sm:text-left">
          <h2 class="text-2xl sm:text-3xl font-extrabold">{t('edu.sponsorTitle')}</h2>
          <p class="text-slate-900 text-sm max-w-xl font-medium">
            {t('edu.sponsorDesc')}
          </p>
        </div>
        <a
          href={translatePath('/donate')}
          class="shrink-0 bg-slate-950 hover:bg-slate-900 text-white font-bold px-8 py-4 rounded-2xl shadow-md transition-all flex items-center gap-2"
        >
          <HeartIcon class="w-5 h-5 shrink-0" />
          <span>{t('action.donateNow')}</span>
        </a>
      </div>

    </div>
  </section>

</Layout>
