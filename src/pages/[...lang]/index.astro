---
import Layout from '../../layouts/Layout.astro';
import { languages } from '../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import ImpactCounter from '../../components/ImpactCounter.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import DonationSection from '../../components/DonationSection.astro';
import VolunteerModal from '../../components/VolunteerModal.astro';
import { Heart, Sparkles, MapPin, CheckCircle, ArrowRight } from 'lucide-astro';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'en' } },
    { params: { lang: 'hi' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang as keyof typeof languages) || 'mr';
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
---

<Layout>
  <!-- Hero Section (Adapts According to Theme) -->
  <section class="relative bg-gradient-to-br from-slate-50 via-emerald-50/40 to-slate-100 dark:from-slate-950 dark:via-brand-950 dark:to-slate-950 text-slate-900 dark:text-white py-20 lg:py-28 overflow-hidden transition-colors duration-300">
    
    <!-- Decorative background elements -->
    <div class="absolute inset-0 opacity-15 dark:opacity-10 bg-[radial-gradient(#059669_1px,transparent_1px)] dark:bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:20px_20px]"></div>
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-500/15 dark:bg-brand-600/30 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Hero Column -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          
          <div class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/30 text-amber-800 dark:text-amber-300 text-xs font-bold px-4 py-1.5 rounded-full shadow-xs">
            <MapPin class="w-3.5 h-3.5 text-amber-600 dark:text-amber-400" />
            <span>{t('ngo.name')} • {t('ngo.badge')}</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight">
            <span class="block bg-gradient-to-r from-slate-900 via-brand-800 to-amber-800 dark:from-white dark:via-slate-100 dark:to-amber-200 bg-clip-text text-transparent">
              {t('ngo.tagline')}
            </span>
          </h1>

          <p class="text-lg text-slate-700 dark:text-slate-300 max-w-2xl font-medium leading-relaxed">
            {t('ngo.subtitle')}
          </p>

          <!-- CTAs -->
          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
            <a
              href={translatePath('/donate')}
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gradient-to-r from-amber-500 to-pune-accent hover:from-amber-600 hover:to-orange-600 text-white font-bold px-8 py-4 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-200 text-base"
            >
              <Heart class="w-5 h-5 fill-white/20" />
              <span>{t('action.donateNow')}</span>
            </a>

            <a
              href={translatePath('/volunteer')}
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-slate-200/80 hover:bg-slate-300/80 dark:bg-white/10 dark:hover:bg-white/20 text-slate-900 dark:text-white font-semibold px-7 py-4 rounded-2xl transition-all duration-200 text-base backdrop-blur-xs"
            >
              <span>{t('action.joinVolunteer')}</span>
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="pt-6 border-t border-slate-300/60 dark:border-white/10 flex items-center justify-center lg:justify-start gap-6 text-xs font-semibold text-slate-600 dark:text-slate-400">
            <div class="flex items-center gap-1.5">
              <CheckCircle class="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
              <span>Registered NGO</span>
            </div>
            <div class="flex items-center gap-1.5">
              <CheckCircle class="w-4 h-4 text-amber-600 dark:text-amber-400" />
              <span>80G Tax Exempt</span>
            </div>
            <div class="flex items-center gap-1.5">
              <CheckCircle class="w-4 h-4 text-blue-600 dark:text-blue-400" />
              <span>100% Transparent</span>
            </div>
          </div>

        </div>

        <!-- Right Hero Column: Volunteer Teaser Form -->
        <div class="lg:col-span-5">
          <VolunteerModal />
        </div>

      </div>
    </div>
  </section>

  <!-- Impact Statistics Banner -->
  <ImpactCounter />

  <!-- Major Programs Showcase -->
  <section class="py-20 bg-slate-100/70 dark:bg-slate-900/50 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 bg-brand-100 dark:bg-brand-950 text-brand-800 dark:text-brand-300 text-xs font-bold px-4 py-1.5 rounded-full mb-3">
          <Sparkles class="w-4 h-4 text-brand-600 dark:text-brand-400" />
          <span>मुख्य उपक्रम • Major Initiatives</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-slate-100">
          प्रमुख कार्यक्षेत्रे व उपक्रम
        </h2>
        <p class="mt-3 text-slate-600 dark:text-slate-300 text-base">
          बालकांच्या शिक्षणाचा पाया मजबूत करणे आणि निसर्ग व पर्यावरण समृद्ध करणे.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        <!-- Education Program Card -->
        <ProgramCard
          title={t('program.education.title')}
          description={t('program.education.desc')}
          category="education"
          features={[
            { title: t('edu.feat1.title'), desc: t('edu.feat1.desc') },
            { title: t('edu.feat2.title'), desc: t('edu.feat2.desc') },
            { title: t('edu.feat3.title'), desc: t('edu.feat3.desc') },
          ]}
          linkUrl={translatePath('/education')}
          linkText={t('action.learnMore')}
        />

        <!-- Environment Program Card -->
        <ProgramCard
          title={t('program.environment.title')}
          description={t('program.environment.desc')}
          category="environment"
          features={[
            { title: t('eco.feat1.title'), desc: t('eco.feat1.desc') },
            { title: t('eco.feat2.title'), desc: t('eco.feat2.desc') },
            { title: t('eco.feat3.title'), desc: t('eco.feat3.desc') },
          ]}
          linkUrl={translatePath('/environment')}
          linkText={t('action.learnMore')}
        />
      </div>

    </div>
  </section>

  <!-- Donation Section -->
  <DonationSection />

</Layout>
