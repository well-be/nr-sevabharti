---
import Layout from '../../layouts/Layout.astro';
import { languages } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { MapPin, Mail, Clock, Send, MessageCircle } from 'lucide-astro';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'en' } },
    { params: { lang: 'hi' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang as keyof typeof languages) || 'mr';
const t = useTranslations(currentLang);
---

<Layout title={`${t('nav.contact')} | ${t('ngo.name')}`}>
  
  <section class="py-16 bg-slate-100/70 dark:bg-slate-950 transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white mb-2">{t('action.contactUs')}</h1>
        <p class="text-slate-600 dark:text-slate-400 text-sm">सेवा भारती पुणे केंद्र • सहकार नगर, पद्मावती परिसर, पुणे</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
        
        <!-- Left: Office Contact Cards -->
        <div class="lg:col-span-5 space-y-6">
          
          <div class="bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex items-start gap-4 transition-colors duration-200">
            <div class="w-10 h-10 rounded-xl bg-brand-100 dark:bg-brand-950 text-brand-700 dark:text-brand-300 flex items-center justify-center shrink-0">
              <MapPin class="w-5 h-5" />
            </div>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white mb-1">मुख्य कार्यालय (Pune Head Office)</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{t('footer.addr')}</p>
            </div>
          </div>

          <div class="bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex items-start gap-4 transition-colors duration-200">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 flex items-center justify-center shrink-0">
              <MessageCircle class="w-5 h-5" />
            </div>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white mb-1">फोन व व्हॉट्सॲप (Phone / WhatsApp)</h3>
              <a href="https://wa.me/919021116405" target="_blank" class="text-sm font-semibold text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-1.5 mt-0.5">
                <span>+91 90211 16405</span>
                <span class="text-[10px] bg-emerald-100 dark:bg-emerald-900/60 px-2 py-0.5 rounded-full text-emerald-800 dark:text-emerald-300">WhatsApp Active</span>
              </a>
            </div>
          </div>

          <div class="bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex items-start gap-4 transition-colors duration-200">
            <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300 flex items-center justify-center shrink-0">
              <Mail class="w-5 h-5" />
            </div>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white mb-1">ईमेल (Email Address)</h3>
              <a href={`mailto:${t('footer.email')}`} class="text-xs text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors leading-relaxed">{t('footer.email')}</a>
            </div>
          </div>

          <div class="bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex items-start gap-4 transition-colors duration-200">
            <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-300 flex items-center justify-center shrink-0">
              <Clock class="w-5 h-5" />
            </div>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white mb-1">कार्यालयीन वेळ (Office Hours)</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">सोमवार ते शनिवार: सकाळी १०:०० ते संध्याकाळी ६:०० (रविवार सुट्टी)</p>
            </div>
          </div>

        </div>

        <!-- Right: Direct Message Form -->
        <div class="lg:col-span-7">
          <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-md transition-colors duration-200">
            <div class="flex items-center justify-between mb-6">
              <h3 class="text-xl font-bold text-slate-900 dark:text-white">आम्हाला संदेश पाठवा (Send us a Message)</h3>
              <span class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold bg-emerald-50 dark:bg-emerald-950 px-2.5 py-1 rounded-full border border-emerald-200 dark:border-emerald-800 flex items-center gap-1">
                <MessageCircle class="w-3.5 h-3.5" />
                <span>Direct WhatsApp</span>
              </span>
            </div>
            
            <form id="contact-form" class="space-y-4">
              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">आपले नाव (Full Name) *</label>
                <input
                  type="text"
                  id="contact-name"
                  required
                  placeholder="उदा. अमित पाटील / Amit Patil"
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 text-sm focus:ring-2 focus:ring-brand-500 outline-none"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">ईमेल (Email)</label>
                  <input
                    type="email"
                    id="contact-email"
                    placeholder="name@example.com"
                    class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 text-sm focus:ring-2 focus:ring-brand-500 outline-none"
                  />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">मोबाईल नंबर (Phone) *</label>
                  <input
                    type="tel"
                    id="contact-phone"
                    required
                    placeholder="+91 90211 16405"
                    class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 text-sm focus:ring-2 focus:ring-brand-500 outline-none"
                  />
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">विषय (Subject) *</label>
                <input
                  type="text"
                  id="contact-subject"
                  required
                  placeholder="उदा. देणगी / स्वयंसेवक / शैक्षणिक मदत"
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 text-sm focus:ring-2 focus:ring-brand-500 outline-none"
                />
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">संदेश (Message) *</label>
                <textarea
                  id="contact-message"
                  rows="4"
                  required
                  placeholder="आपला संदेश येथे लिहा..."
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 text-sm focus:ring-2 focus:ring-brand-500 outline-none"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 rounded-xl shadow-md transition-all text-sm cursor-pointer"
              >
                <Send class="w-4 h-4" />
                <span>व्हॉट्सॲपवर संदेश पाठवा (Send via WhatsApp)</span>
              </button>
            </form>

          </div>
        </div>

      </div>

    </div>
  </section>

</Layout>

<script>
  function handleContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value.trim() || '';
      const email = (document.getElementById('contact-email') as HTMLInputElement)?.value.trim() || 'Not Provided';
      const phone = (document.getElementById('contact-phone') as HTMLInputElement)?.value.trim() || '';
      const subject = (document.getElementById('contact-subject') as HTMLInputElement)?.value.trim() || '';
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value.trim() || '';

      if (!name || !phone || !subject || !message) {
        alert('कृपया सर्व आवश्यक माहिती भरा. (Please fill in all required fields.)');
        return;
      }

      const whatsappMessage = 
`*सेवा भारती पुणे - संपर्क संदेश*
━━━━━━━━━━━━━━━━━━━
👤 *नाव (Name):* ${name}
📱 *मोबाईल (Phone):* ${phone}
📧 *ईमेल (Email):* ${email}
📝 *विषय (Subject):* ${subject}
💬 *संदेश (Message):*
${message}
━━━━━━━━━━━━━━━━━━━
_Sent via nrsevabharti.com_`;

      const whatsappUrl = `https://wa.me/919021116405?text=${encodeURIComponent(whatsappMessage)}`;
      window.open(whatsappUrl, '_blank');
    });
  }

  handleContactForm();
  document.addEventListener('astro:after-swap', handleContactForm);
</script>
