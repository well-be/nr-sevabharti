---
import Layout from '../../layouts/Layout.astro';
import { languages } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { MapPin, Mail, Clock, Send, MessageCircle } from 'lucide-astro';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'en' } },
    { params: { lang: 'hi' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang as keyof typeof languages) || 'mr';
const t = useTranslations(currentLang);
---

<Layout title={`${t('nav.contact')} | ${t('ngo.name')}`}>
  
  <section class="py-16 bg-slate-100/70 dark:bg-slate-950 transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white mb-2">{t('contact.title')}</h1>
        <p class="text-slate-600 dark:text-slate-400 text-sm">{t('contact.subtitle')}</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
        
        <!-- Left: Office Contact Cards -->
        <div class="lg:col-span-5 space-y-6">
          
          <div class="bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-xs flex items-start gap-4 transition-colors duration-200">
            <div class="w-10 h-10 rounded-xl bg-palette-indigo/15 text-palette-indigo dark:text-palette-sky flex items-center justify-center shrink-0 border border-palette-indigo/20">
              <MapPin class="w-5 h-5" />
            </div>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white mb-1">{t('contact.office')}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{t('footer.addr')}</p>
            </div>
          </div>

          <div class="bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-xs flex items-start gap-4 transition-colors duration-200">
            <div class="w-10 h-10 rounded-xl bg-palette-aqua/25 text-palette-indigo dark:text-palette-aqua flex items-center justify-center shrink-0 border border-palette-aqua/30">
              <MessageCircle class="w-5 h-5" />
            </div>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white mb-1">{t('contact.phone')}</h3>
              <a href="https://wa.me/918285129797" target="_blank" class="text-sm font-semibold text-palette-indigo dark:text-palette-aqua hover:underline flex items-center gap-1.5 mt-0.5">
                <span>+91 82851 29797 / +91 90211 16405</span>
              </a>
            </div>
          </div>

          <div class="bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-xs flex items-start gap-4 transition-colors duration-200">
            <div class="w-10 h-10 rounded-xl bg-palette-indigo/15 text-palette-indigo dark:text-palette-sky flex items-center justify-center shrink-0 border border-palette-indigo/20">
              <Mail class="w-5 h-5" />
            </div>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white mb-1">{t('contact.email')}</h3>
              <a href={`mailto:${t('footer.email')}`} class="text-xs text-slate-600 dark:text-slate-400 hover:text-palette-indigo dark:hover:text-palette-aqua transition-colors leading-relaxed">{t('footer.email')}</a>
            </div>
          </div>

          <div class="bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-xs flex items-start gap-4 transition-colors duration-200">
            <div class="w-10 h-10 rounded-xl bg-palette-gold/20 text-palette-gold-dark dark:text-palette-gold flex items-center justify-center shrink-0 border border-palette-gold/30">
              <Clock class="w-5 h-5" />
            </div>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white mb-1">{t('contact.hours')}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{t('contact.hoursText')}</p>
            </div>
          </div>

        </div>

        <!-- Right: Direct Message Form -->
        <div class="lg:col-span-7">
          <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-md transition-colors duration-200">
            <div class="flex items-center justify-between mb-6">
              <h3 class="text-xl font-bold text-slate-900 dark:text-white">{t('contact.formTitle')}</h3>
              <span class="text-xs text-palette-indigo dark:text-palette-aqua font-semibold bg-palette-aqua/20 dark:bg-palette-indigo/40 px-2.5 py-1 rounded-full border border-palette-aqua/40 dark:border-palette-indigo/50 flex items-center gap-1">
                <MessageCircle class="w-3.5 h-3.5" />
                <span>WhatsApp</span>
              </span>
            </div>
            
            <form
              id="contact-form"
              class="space-y-4"
              data-lang={currentLang}
              data-alert-msg={t('contact.alertFill')}
            >
              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">{t('contact.nameLabel')} *</label>
                <input
                  type="text"
                  id="contact-name"
                  required
                  placeholder={t('contact.namePlaceholder')}
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 text-sm focus:ring-2 focus:ring-palette-indigo outline-none"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">{t('contact.emailLabel')}</label>
                  <input
                    type="email"
                    id="contact-email"
                    placeholder={t('contact.emailPlaceholder')}
                    class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 text-sm focus:ring-2 focus:ring-palette-indigo outline-none"
                  />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">{t('contact.phoneLabel')} *</label>
                  <input
                    type="tel"
                    id="contact-phone"
                    required
                    placeholder="+91 82851 29797"
                    class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 text-sm focus:ring-2 focus:ring-palette-indigo outline-none"
                  />
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">{t('contact.subjectLabel')} *</label>
                <input
                  type="text"
                  id="contact-subject"
                  required
                  placeholder={t('contact.subjectPlaceholder')}
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 text-sm focus:ring-2 focus:ring-palette-indigo outline-none"
                />
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">{t('contact.msgLabel')} *</label>
                <textarea
                  id="contact-message"
                  rows="4"
                  required
                  placeholder={t('contact.msgPlaceholder')}
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 text-sm focus:ring-2 focus:ring-palette-indigo outline-none"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full flex items-center justify-center gap-2 bg-gradient-to-r from-palette-indigo to-palette-sky hover:brightness-110 text-white font-bold py-3.5 rounded-xl shadow-md transition-all text-sm cursor-pointer"
              >
                <Send class="w-4 h-4" />
                <span>{t('contact.submit')}</span>
              </button>
            </form>

          </div>
        </div>

      </div>

    </div>
  </section>

</Layout>

<script>
  function handleContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const lang = form.dataset.lang || 'mr';
      const alertMsg = form.dataset.alertMsg || 'Please fill in all required fields.';

      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value.trim() || '';
      const email = (document.getElementById('contact-email') as HTMLInputElement)?.value.trim() || '-';
      const phone = (document.getElementById('contact-phone') as HTMLInputElement)?.value.trim() || '';
      const subject = (document.getElementById('contact-subject') as HTMLInputElement)?.value.trim() || '';
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value.trim() || '';

      if (!name || !phone || !subject || !message) {
        alert(alertMsg);
        return;
      }

      let whatsappMessage = '';
      if (lang === 'mr') {
        whatsappMessage = 
`*सेवा भारती पुणे - संपर्क संदेश*
━━━━━━━━━━━━━━━━━━━
👤 *नाव:* ${name}
📱 *मोबाईल:* ${phone}
📧 *ईमेल:* ${email}
📝 *विषय:* ${subject}
💬 *संदेश:*
${message}
━━━━━━━━━━━━━━━━━━━
_nrsevabharti.com वरून पाठवले_`;
      } else if (lang === 'hi') {
        whatsappMessage = 
`*सेवा भारती पुणे - संपर्क संदेश*
━━━━━━━━━━━━━━━━━━━
👤 *नाम:* ${name}
📱 *मोबाइल:* ${phone}
📧 *ईमेल:* ${email}
📝 *विषय:* ${subject}
💬 *संदेश:*
${message}
━━━━━━━━━━━━━━━━━━━
_nrsevabharti.com से प्रेषित_`;
      } else {
        whatsappMessage = 
`*Seva Bharti Pune - Contact Message*
━━━━━━━━━━━━━━━━━━━
👤 *Name:* ${name}
📱 *Phone:* ${phone}
📧 *Email:* ${email}
📝 *Subject:* ${subject}
💬 *Message:*
${message}
━━━━━━━━━━━━━━━━━━━
_Sent via nrsevabharti.com_`;
      }

      const whatsappUrl = `https://wa.me/918285129797?text=${encodeURIComponent(whatsappMessage)}`;
      window.open(whatsappUrl, '_blank');
    });
  }

  handleContactForm();
  document.addEventListener('astro:after-swap', handleContactForm);
</script>
