---
import Layout from '../../layouts/Layout.astro';
import { languages } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import DonationSection from '../../components/DonationSection.astro';
import { HelpCircle, CheckSquare } from 'lucide-astro';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'en' } },
    { params: { lang: 'hi' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang as keyof typeof languages) || 'mr';
const t = useTranslations(currentLang);

const faqs = [
  {
    q: t('donate.faq1.q'),
    a: t('donate.faq1.a')
  },
  {
    q: t('donate.faq2.q'),
    a: t('donate.faq2.a')
  },
  {
    q: t('donate.faq3.q'),
    a: t('donate.faq3.a')
  }
];
---

<Layout title={`${t('nav.donate')} | ${t('ngo.name')}`}>
  
  <DonationSection />

  <!-- Cheque / DD Guidance Card (Inspired by Kokan NGO's payment transparency) -->
  <section class="py-10 bg-slate-50 dark:bg-slate-900/50 border-t border-slate-200/80 dark:border-slate-800 transition-colors duration-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-palette-indigo/25 shadow-xs flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-palette-indigo/15 text-palette-indigo dark:text-palette-aqua flex items-center justify-center shrink-0 border border-palette-indigo/20">
          <CheckSquare class="w-6 h-6" />
        </div>
        <div class="space-y-1">
          <h4 class="text-base font-bold text-slate-900 dark:text-white">
            {t('donate.chequeTitle')}
          </h4>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {t('donate.chequeDesc')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-white dark:bg-slate-950 border-t border-slate-200/80 dark:border-slate-800 transition-colors duration-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-12">
        <div class="w-10 h-10 rounded-xl bg-palette-gold/20 text-palette-gold-dark dark:text-palette-gold flex items-center justify-center mx-auto mb-3 border border-palette-gold/30">
          <HelpCircle class="w-5 h-5" />
        </div>
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white">{t('donate.faqTitle')}</h3>
      </div>

      <div class="space-y-5">
        {faqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 transition-colors duration-200 shadow-xs">
            <h4 class="text-base font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2">
              <span class="text-palette-gold font-extrabold">Q.</span>
              <span>{faq.q}</span>
            </h4>
            <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed pl-6">
              {faq.a}
            </p>
          </div>
        ))}
      </div>

      <!-- Need Help / CSR Info -->
      <div class="mt-12 text-center text-xs text-slate-500 dark:text-slate-400">
        <p>{t('donate.csrContact')} <a href={`mailto:${t('footer.email')}`} class="text-palette-indigo dark:text-palette-aqua font-semibold underline">{t('footer.email')}</a></p>
      </div>

    </div>
  </section>

</Layout>
