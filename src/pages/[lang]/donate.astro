---
import Layout from '../../layouts/Layout.astro';
import { languages } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import DonationSection from '../../components/DonationSection.astro';
import { HelpCircle } from 'lucide-astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLang = (lang as keyof typeof languages) || 'mr';
const t = useTranslations(currentLang);

const faqs = [
  {
    q: '८०G कर सवलत पावती कशी मिळेल? (How to get 80G Tax Receipt?)',
    a: 'आपली देणगी पूर्ण झाल्यानंतर ट्रान्सफरचा स्क्रीनशॉट / युटीआर (UTR) नंबर आणि आपला पॅन कार्ड (PAN Card) क्रमांक +91 98220 00000 या नंबरवर व्हॉट्सॲप करा. पावती ३ कामकाजाच्या दिवसांत डिजिटल स्वरूपात पाठवली जाईल.'
  },
  {
    q: 'माझी देणगी कुठल्या उपक्रमासाठी वापरली जाते?',
    a: 'आपण दिलेल्या देणगीचा १००% उपयोग पुणे जिल्ह्यातील बालकांच्या शैक्षणिक साहित्यासाठी आणि सह्याद्री डोंगररांगातील वृक्ष लागवड व तीन वर्षांच्या संगोपनासाठी केला जातो.'
  },
  {
    q: 'मी रोख (Cash) स्वरूपात देणगी देऊ शकतो का?',
    a: 'पारदर्शकता राखण्यासाठी आम्ही ऑनलाइन बँक ट्रान्सफर, युपीआय (UPI) किंवा धनादेश (Cheque - "Seva Bharti Pune" नावाने) स्वीकारतो.'
  }
];
---

<Layout title={`${t('nav.donate')} | ${t('ngo.name')}`}>
  
  <DonationSection />

  <!-- FAQ Section -->
  <section class="py-16 bg-white dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800 transition-colors duration-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-12">
        <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-900 text-slate-700 dark:text-slate-300 flex items-center justify-center mx-auto mb-3">
          <HelpCircle class="w-5 h-5" />
        </div>
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white">देणगीविषयक वारंवार विचारले जाणारे प्रश्न (FAQs)</h3>
      </div>

      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 transition-colors duration-200">
            <h4 class="text-base font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2">
              <span class="text-amber-600 dark:text-amber-400 font-extrabold">Q.</span>
              <span>{faq.q}</span>
            </h4>
            <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed pl-6">
              {faq.a}
            </p>
          </div>
        ))}
      </div>

      <!-- Need Help Info -->
      <div class="mt-12 text-center text-xs text-slate-500 dark:text-slate-400">
        <p>अधिक मदतीसाठी किंवा सीएसआर (CSR) सहकार्यासाठी संपर्क: <a href="mailto:info@sevabhartipune.org" class="text-brand-600 dark:text-brand-400 font-semibold underline">info@sevabhartipune.org</a></p>
      </div>

    </div>
  </section>

</Layout>
