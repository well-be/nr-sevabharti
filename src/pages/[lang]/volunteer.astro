---
import Layout from '../../layouts/Layout.astro';
import { languages } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import VolunteerModal from '../../components/VolunteerModal.astro';
import { Users, Calendar, MapPin, Clock, CheckCircle2 } from 'lucide-astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLang = (lang as keyof typeof languages) || 'mr';
const t = useTranslations(currentLang);

const upcomingDrives = [
  {
    title: 'सिंहगड पायथा वृक्षारोपण मोहीम',
    date: 'रविवार, २३ ऑगस्ट २०२६',
    time: 'सकाळी ७:०० ते १०:००',
    location: 'डोणजे गाव, सिंहगड पायथा, पुणे',
    category: 'पर्यावरण',
    badge: 'bg-emerald-100 text-emerald-800'
  },
  {
    title: 'पद्मावती अभ्यासवर्ग शिक्षक प्रशिक्षण',
    date: 'शनिवार, २९ ऑगस्ट २०२६',
    time: 'दुपारी ४:०० ते ६:००',
    location: 'सहकार नगर केंद्र, पुणे',
    category: 'शिक्षण',
    badge: 'bg-amber-100 text-amber-800'
  },
  {
    title: 'मुळा-मुठा नदी घाट स्वच्छता drive',
    date: 'रविवार, ६ सप्टेंबर २०२६',
    time: 'सकाळी ६:३० ते ९:००',
    location: 'संगमघाट, पुणे शहर',
    category: 'पर्यावरण',
    badge: 'bg-emerald-100 text-emerald-800'
  }
];
---

<Layout title={`${t('vol.title')} | ${t('ngo.name')}`}>
  
  <section class="py-16 bg-slate-100/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left: Volunteer Form -->
        <div class="lg:col-span-6">
          <VolunteerModal />
        </div>

        <!-- Right: Upcoming Drives Calendar in Pune -->
        <div class="lg:col-span-6 space-y-6">
          <div class="glass-card p-8 rounded-3xl">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300 flex items-center justify-center">
                <Calendar class="w-5 h-5" />
              </div>
              <div>
                <h3 class="text-xl font-bold text-slate-900 dark:text-slate-100">आगामी स्वयंसेवक मोहिमा (Upcoming Drives)</h3>
                <p class="text-xs text-slate-600 dark:text-slate-400 font-medium">पुणे शहरातील थेट मोहिमेत सहभागी व्हा</p>
              </div>
            </div>

            <div class="space-y-4">
              {upcomingDrives.map((drive) => (
                <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 transition-colors">
                  <div class="flex items-center justify-between mb-2">
                    <span class={`text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full ${drive.badge}`}>
                      {drive.category}
                    </span>
                    <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 flex items-center gap-1">
                      <Calendar class="w-3 h-3 text-slate-400" />
                      {drive.date}
                    </span>
                  </div>
                  <h4 class="text-base font-bold text-slate-900 dark:text-slate-100 mb-1">{drive.title}</h4>
                  <div class="flex flex-wrap gap-4 text-xs text-slate-700 dark:text-slate-300">
                    <span class="flex items-center gap-1">
                      <Clock class="w-3.5 h-3.5 text-slate-400" />
                      {drive.time}
                    </span>
                    <span class="flex items-center gap-1">
                      <MapPin class="w-3.5 h-3.5 text-slate-400" />
                      {drive.location}
                    </span>
                  </div>
                </div>
              ))}
            </div>

          </div>

          <!-- Why Volunteer Card -->
          <div class="bg-gradient-to-br from-slate-900 to-brand-950 text-white p-6 rounded-3xl space-y-3">
            <h4 class="font-bold text-base text-amber-300">स्वयंसेवक होण्याचे फायदे:</h4>
            <ul class="text-xs text-slate-300 space-y-2">
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
                <span>पुण्यातील सामाजिक समस्यांवर थेट प्रत्यक्ष काम करण्याचा अनुभव</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
                <span>स्वयंसेवक सहभाग प्रमाणपत्र (Volunteer Certificate)</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
                <span>समानविचारी युवा नेटवर्किंग व नेतृत्व कौशल्य विकास</span>
              </li>
            </ul>
          </div>

        </div>

      </div>

    </div>
  </section>

</Layout>
